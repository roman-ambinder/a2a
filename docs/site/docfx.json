{
  "metadata": [
    {
      "src": [
        {
          "src": "../../src",
          "files": ["**/*.csproj"],
          "exclude": ["A2A.Cli/**", "A2A.Templates/**", "A2A.Analyzers/**", "A2A.Analyzers.CodeFixes/**"]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "properties": {
        "TargetFramework": "net10.0",
        "DocfxMetadata": "true"
      },
      "disableGitFeatures": true,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": ["index.md", "toc.yml", "guides/**/*.md", "guides/**/toc.yml"]
      },
      {
        "files": ["api/**/*.yml", "api/index.md"]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appTitle": "A2A .NET SDK",
      "_enableSearch": true,
      "_disableContribution": true,
      "_appName": "A2A .NET SDK",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/logo.svg",
      "_appFooter": "A2A .NET SDK · <a href=\"https://github.com/roman-ambinder/a2a\">GitHub</a> · Apache License 2.0"
    },
    "template": ["default", "modern", "template"],
    "markdownEngineProperties": {
      "markdigExtensions": ["Alerts"]
    }
  }
}
