{
  "stryker-config": {
    "project": "A2A.Security.Http.csproj",
    "test-runner": "mtp",
    "target-framework": "net10.0",
    "configuration": "Release",
    "coverage-analysis": "off",
    "reporters": [
      "html",
      "json",
      "markdown",
      "cleartext"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "test-case-filter": "FullyQualifiedName~A2A.Tests.ArtifactDownloaderTests.|FullyQualifiedName~A2A.Tests.CardTrustTests.|FullyQualifiedName~A2A.Tests.InteropHardeningTests.|FullyQualifiedName~A2A.Tests.PushUrlValidatorTests.|FullyQualifiedName~A2A.Tests.SigningTests.|FullyQualifiedName~A2A.Tests.PushDeliveryTests.|FullyQualifiedName~A2A.Tests.Telemetry.SecurityEventTests.|FullyQualifiedName~A2A.Tests.SafeHttpTests."
  }
}
