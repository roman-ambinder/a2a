<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>A2A.Extensions.AI</RootNamespace>
        <Description>Microsoft.Extensions.AI integration for A2A (Agent2Agent): host an IChatClient as an A2A agent, call a remote agent as an AI tool, or use it as an IChatClient.</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\A2A.Client\A2A.Client.csproj"/>
        <ProjectReference Include="..\A2A.Server\A2A.Server.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Shared\AI\*.cs" Link="Shared\AI\%(Filename)%(Extension)"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    </ItemGroup>
</Project>
