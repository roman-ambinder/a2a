<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>A2A.Grpc</RootNamespace>
    <IncludeGoogleApiCommonProtos>true</IncludeGoogleApiCommonProtos>
    <Description>A2A (Agent2Agent) gRPC binding: generated protobuf types and stubs for a2a.proto, plus mapping to the A2A .NET model.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\A2A.Protocol\A2A.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.StatusProto" />
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\..\docs\a2a.proto" ProtoRoot="..\..\docs" GrpcServices="Both" Access="Public" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="A2A.Tests" />
  </ItemGroup>
</Project>
