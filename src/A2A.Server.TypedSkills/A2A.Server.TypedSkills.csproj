<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>A2A.Server.TypedSkills</RootNamespace>
        <Description>Typed skills for an A2A (Agent2Agent) server: declare a skill with .NET input and output types, get JSON Schema on the Agent Card, and have bad input refused before the agent runs. AOT safe.</Description>
        <PackageTags>$(PackageTags);skills;json-schema</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\A2A.Server\A2A.Server.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    </ItemGroup>
</Project>
