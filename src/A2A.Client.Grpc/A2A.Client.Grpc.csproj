<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>A2A.Client.Grpc</RootNamespace>
        <Description>gRPC transport for the A2A (Agent2Agent) .NET client (spec §10).</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\A2A.Grpc\A2A.Grpc.csproj"/>
        <ProjectReference Include="..\A2A.Client\A2A.Client.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Grpc.Net.Client"/>
    </ItemGroup>
    <ItemGroup>
        <!-- One source for the rules of custom operation calls. A2A.Client keeps it internal, and no assembly may see its internals. -->
        <Compile Include="..\A2A.Client\ExtensionOperationParams.cs" Link="ExtensionOperationParams.cs"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="A2A.Grpc.Tests"/>
    </ItemGroup>
</Project>
