{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "A2A": {
    // The address other agents reach this one at, for example "https://agent.example.com". The Agent Card lists its
    // interfaces under it. Empty: the first address the server listens on, which is fine for local work.
    "PublicBaseUrl": "",
//#if (AuthApiKey)
    // One entry per caller. "a2a keys new" prints a key and its hash: the caller gets the key, this file only the hash.
    // "Keys": [ { "CallerId": "my-caller", "Hash": "sha256:..." } ]
    "ApiKeys": {
      "Keys": []
    },
//#endif
    "Card": {
      "Name": "A2AAgent1",
      "Description": "Answers every message.",
      "Version": "1.0.0",
      "DefaultInputModes": [ "text/plain" ],
      "DefaultOutputModes": [ "text/plain" ],
      "Skills": [
        { "Id": "answer", "Name": "Answer", "Description": "Answers a message", "Tags": [ "example" ], "Examples": [ "hello" ] }
      ]
    }
  }
}
