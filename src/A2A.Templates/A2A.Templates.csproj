<Project Sdk="Microsoft.NET.Sdk">
    <!-- A dotnet new template pack (dotnet new install RomanAmbinder.A2A.Templates). It has no code of its own: the templates
         are under content/, and the pack stamps this package's version into them (A2A_PACKAGE_VERSION), so a project made
         from the pack references the SDK release it came with. -->
    <PropertyGroup>
        <PackageType>Template</PackageType>
        <Description>dotnet new templates for the A2A (Agent2Agent) .NET SDK: an agent (a2a-agent), a client (a2a-client) and an agent that hosts an IChatClient (a2a-chat-agent).</Description>
        <PackageTags>$(PackageTags);dotnet-new;templates</PackageTags>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeSymbols>false</IncludeSymbols>
        <EnablePackageValidation>false</EnablePackageValidation>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <!-- NU5128: a template pack has no lib folder on purpose. -->
        <EnableDefaultItems>false</EnableDefaultItems>
    </PropertyGroup>
    <ItemGroup>
        <TemplateSource Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**"/>
    </ItemGroup>

    <!-- Copies the templates under obj/ and packs that copy. Files are copied byte for byte; only the project files get the
         package version stamped in (MSBuild's WriteLinesToFile would rewrite backslashes in other files). -->
    <Target Name="StageTemplates" BeforeTargets="_GetPackageFiles">
        <PropertyGroup>
            <TemplateStage>$(IntermediateOutputPath)templates/</TemplateStage>
        </PropertyGroup>
        <ItemGroup>
            <_TemplateProject Include="@(TemplateSource)" Condition="'%(Extension)' == '.csproj'"/>
            <_TemplateFile Include="@(TemplateSource)" Condition="'%(Extension)' != '.csproj'"/>
        </ItemGroup>
        <Copy SourceFiles="@(_TemplateFile)" DestinationFiles="@(_TemplateFile->'$(TemplateStage)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <WriteLinesToFile File="$(TemplateStage)%(_TemplateProject.RecursiveDir)%(_TemplateProject.Filename)%(_TemplateProject.Extension)"
                          Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(_TemplateProject.FullPath)').Replace('A2A_PACKAGE_VERSION', '$(PackageVersion)'))))"
                          Overwrite="true" WriteOnlyWhenDifferent="true"/>
        <ItemGroup>
            <None Include="$(TemplateStage)**/*" Pack="true" PackagePath="content/%(RecursiveDir)"/>
        </ItemGroup>
    </Target>
</Project>
